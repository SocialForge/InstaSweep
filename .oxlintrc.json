{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["oxc", "unicorn", "typescript", "react", "import", "jsx-a11y", "promise"],
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "perf": "error",

        "style": "off",
        "pedantic": "off",
        "restriction": "off",
        "nursery": "off"
    },
    "env": {
        "browser": true,
        "es2024": true,
        "webextensions": true
    },
    "ignorePatterns": ["public/background.js", "public/dist.js"],
    "options": {
        "denyWarnings": true,
        "reportUnusedDisableDirectives": "error",
        "typeAware": true
    },
    "rules": {
        "no-await-in-loop": "off",
        "react/preserve-manual-memoization": "off",
        "react/set-state-in-effect": "off",
        "unicorn/no-array-sort": "off"
    }
}
